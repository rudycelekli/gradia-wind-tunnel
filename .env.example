# =============================================================================
# Gradia Wind Tunnel — environment template
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# The CLI auto-loads `.env` from the working directory.
# =============================================================================

# -----------------------------------------------------------------------------
# HOW CREDENTIALS FLOW (read this)
# -----------------------------------------------------------------------------
# The secure design (recommended): your REAL provider keys live in the GRADIA
# GUARD GATEWAY process — NOT here. This Wind Tunnel process holds only a
# capability (a decoy that doubles as the SDK key). Guard swaps in the real key
# and forwards to the provider, and every call becomes a hash-chained receipt.
#
#   [Wind Tunnel] --(x-api-key: CAPABILITY)--> [Guard gateway holds real key] --> provider
#
# So: put CAPABILITY + gateway URL below; put the REAL keys in the gateway's own
# config (bottom section), which this process never reads.
#
# Quick first-number mode (less pure, fine for Phase 0): skip the gateway, set
# GRADIA_GUARD_GATEWAY_URL=https://api.anthropic.com and put your REAL Anthropic
# key in GRADIA_GUARD_LOCAL_CAPABILITY. The grader then posts directly to the
# provider. Switch to the gateway before scaling.

# -----------------------------------------------------------------------------
# WIND TUNNEL PROCESS — what this repo reads
# -----------------------------------------------------------------------------

# The Guard local capability (decoy key). In gateway mode this comes from Guard.
# In quick mode, put your REAL provider key here instead.
GRADIA_GUARD_LOCAL_CAPABILITY=

# Where grading requests go. Guard gateway (recommended) or the provider directly.
GRADIA_GUARD_GATEWAY_URL=http://127.0.0.1:8787

# Which model grades (and, later, acts as adversary). Pin an exact id.
GRADIA_WT_MODEL=claude-opus-5

# Token prices for cost tracking (USD per 1,000,000 tokens). Match the prereg.
GRADIA_WT_INPUT_USD_PER_MTOK=5
GRADIA_WT_OUTPUT_USD_PER_MTOK=25

# Hard spend cap (fail-closed). Match the frozen preregistration's spend_policy.
GRADIA_WT_MAX_COST_USD=300

# The frozen preregistration self-digest (from `prereg-verify`), stamped onto
# every result so each run points back to the committed design.
GRADIA_WT_PREREG_SHA256=

# -----------------------------------------------------------------------------
# DATASETS — for real-benchmark loading (needs network)
# -----------------------------------------------------------------------------
# HuggingFace token. Required for GATED datasets (e.g. GPQA); optional for open
# ones (GSM8K, MATH, HumanEval).
HF_TOKEN=

# -----------------------------------------------------------------------------
# ANALYTICS — optional; stream frames.ndjson into Gradia analytics / a warehouse
# -----------------------------------------------------------------------------
GRADIA_ANALYTICS_URL=
GRADIA_ANALYTICS_TOKEN=

# =============================================================================
# GRADIA GUARD GATEWAY CONFIG — the REAL provider keys live HERE, not above.
# These belong in the gateway process's own environment. Listed for convenience;
# the Wind Tunnel process does NOT read them. Fill only the providers you use.
# =============================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
